# RUN: llc -mtriple=amdgcn -mcpu=gfx1250-strict -amdgpu-expert-scheduling-mode -run-pass si-insert-waitcnts %s -o - | FileCheck %s

# CHECK-LABEL: name: inline_asm_vgpr_store
# CHECK: INLINEASM
# CHECK-NEXT: S_WAITCNT_DEPCTR .VaVdst_0
# CHECK-NEXT: DS_WRITE_B32_gfx9 $vgpr24, $vgpr30
---
name: inline_asm_vgpr_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr24

    INLINEASM &"v_min_f32 $0, $1, $1", sideeffect attdialect, regdef:VGPR_32_Lo256, def $vgpr30, reguse:VGPR_32_Lo256, $vgpr0
    DS_WRITE_B32_gfx9 $vgpr24, $vgpr30, 0, 0, implicit $exec
    S_ENDPGM 0
...
