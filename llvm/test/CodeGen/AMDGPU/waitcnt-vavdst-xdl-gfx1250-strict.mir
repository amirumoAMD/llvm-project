# RUN: llc -mtriple=amdgcn -mcpu=gfx1250 -amdgpu-expert-scheduling-mode -run-pass si-insert-waitcnts %s -o - | FileCheck --check-prefix=GFX1250 %s
# RUN: llc -mtriple=amdgcn -mcpu=gfx1250-strict -amdgpu-expert-scheduling-mode -run-pass si-insert-waitcnts %s -o - | FileCheck --check-prefix=STRICT %s

# GFX1250-LABEL: name: mixed_wmma_valu
# GFX1250: S_WAITCNT_DEPCTR .VaVdst_1
# GFX1250-NEXT: DS_WRITE_B32_gfx9 $vgpr24, $vgpr16
# STRICT-LABEL: name: mixed_wmma_valu
# STRICT: S_WAITCNT_DEPCTR .VaVdst_0
# STRICT-NEXT: DS_WRITE_B32_gfx9 $vgpr24, $vgpr16

---
name: mixed_wmma_valu
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1, $vgpr2, $vgpr3, $vgpr4, $vgpr5, $vgpr6, $vgpr7, $vgpr8, $vgpr9, $vgpr10, $vgpr11, $vgpr12, $vgpr13, $vgpr14, $vgpr15, $vgpr16, $vgpr17, $vgpr18, $vgpr19, $vgpr20, $vgpr21, $vgpr22, $vgpr23, $vgpr24, $vgpr31

    $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23 = V_WMMA_F32_16X16X32_BF16_w32_twoaddr $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 8, $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23, 0, 0, 0, 0, implicit $exec
    $vgpr30 = V_MOV_B32_e32 $vgpr31, implicit $exec
    DS_WRITE_B32_gfx9 $vgpr24, $vgpr16, 0, 0, implicit $exec
    S_ENDPGM 0
...
